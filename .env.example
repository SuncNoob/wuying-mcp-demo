# Copy to .env. Never commit real endpoint URLs, tokens or desktop output.
WUYING_MCP_URL=https://YOUR-WUYING-MCP-HOST/mcp
# Set only if your endpoint actually uses Bearer authentication.
WUYING_MCP_TOKEN=
WUYING_MCP_TRANSPORT=streamable-http
# observe: inspect only; interactive: enable supported browser/desktop input.
WUYING_MCP_PROFILE=observe
WUYING_MCP_TIMEOUT_MS=30000
# Alternative: an absolute path to an exported/local JSON configuration.
# WUYING_MCP_CONFIG=/absolute/path/config.local.json
# WUYING_MCP_SERVER=server-name
