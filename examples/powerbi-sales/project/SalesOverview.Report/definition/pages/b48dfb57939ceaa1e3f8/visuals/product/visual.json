            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "SalesData"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "SalesData.Total Revenue",
              "nativeQueryRef": "Total Revenue"
