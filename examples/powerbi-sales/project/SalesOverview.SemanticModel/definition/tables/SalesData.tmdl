table SalesData
	lineageTag: aa14535b-e6a3-4aa6-bb3b-c94b01ea9050

	measure 'Total Revenue' = SUM(SalesData[Revenue])
		formatString: #,0

	measure 'Total Profit' = SUM(SalesData[Profit])
		formatString: #,0

	measure 'Profit Margin' = DIVIDE([Total Profit], [Total Revenue])
		formatString: 0.00%

	measure 'Order Count' = COUNTROWS(SalesData)
		formatString: #,0

	column OrderID
		dataType: string
		lineageTag: 4b0c6425-913c-42bb-92fe-5a2fedce8260
		summarizeBy: none
		sourceColumn: OrderID

		annotation SummarizationSetBy = Automatic

